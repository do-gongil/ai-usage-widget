<Window
    x:Class="UsageWidget.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Padding="12,8,12,10" RowDefinitions="Auto,*">
        <!-- 드래그 영역(DragArea) 안의 버튼은 클릭이 안 되므로 버튼들은 그 밖에 둔다. 닫기 버튼은 OS가 오른쪽에 그린다 -->
        <Grid x:Name="Header" Height="28" ColumnDefinitions="Auto,Auto,Auto,*,Auto">
            <Button x:Name="RefreshButton" Content="&#xE72C;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                    FontSize="12" Padding="6,4" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="지금 새로고침" AutomationProperties.Name="지금 새로고침" Click="Refresh_Click" />
            <TextBlock x:Name="Footer" Grid.Column="1" Margin="4,0,2,0" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
            <Button Grid.Column="2" Content="&#xE713;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                    FontSize="12" Padding="6,4" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="설정" AutomationProperties.Name="설정">
                <Button.Flyout>
                    <!-- 창이 작아도 잘리지 않게 창 밖으로 띄운다 -->
                    <Flyout ShouldConstrainToRootBounds="False">
                        <StackPanel Width="220" Spacing="12">
                            <ToggleSwitch x:Name="TopMostSwitch" Header="항상 위" Toggled="TopMost_Toggled" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="창 색상" />
                                <VariableSizedWrapGrid x:Name="Swatches" Orientation="Horizontal"
                                                       ItemWidth="30" ItemHeight="30" MaximumRowsOrColumns="7" />
                            </StackPanel>
                            <Slider x:Name="OpacitySlider" Header="투명도" Minimum="30" Maximum="100" StepFrequency="5"
                                    ValueChanged="Opacity_Changed" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Grid x:Name="DragArea" Grid.Column="3" Background="Transparent" />
            <!-- 닫기(X) 바로 왼쪽: 오른쪽 여백은 코드에서 X 버튼 영역만큼 맞춘다 -->
            <Button x:Name="MiniButton" Grid.Column="4" Content="&#xE921;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                    FontSize="12" Padding="6,4" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="미니 모드 (Ctrl+Alt+U)" AutomationProperties.Name="미니 모드" Click="Mini_Click" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <!-- 미니 모드에서는 Rows 전체가 드래그 영역이 된다 (Background가 있어야 잡힌다) -->
            <StackPanel x:Name="Rows" Spacing="6" Margin="0,6,0,0" Background="Transparent" />
            <Button x:Name="RestoreButton" Grid.Column="1" Visibility="Collapsed" Content="&#xE740;"
                    FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="11" Padding="4" Margin="4,0,0,0"
                    VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="일반 창으로 (Ctrl+Alt+U)" AutomationProperties.Name="일반 창으로" Click="Mini_Click" />
        </Grid>
    </Grid>
</Window>
